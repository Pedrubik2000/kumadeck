{
  "name": "kumadeck",
  "version": "0.3.1",
  "description": "Decky plugin: capture VN text boxes, OCR them locally, and pipe the text to Yomitan for lookup and Anki mining — all from gaming mode.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pedrubik2000/kumadeck.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "ocr",
    "yomitan",
    "japanese",
    "visual-novel"
  ],
  "author": "Simon Callsen",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@eslint/js": "^10.0.1",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.11.0",
    "qrcode-generator": "^1.5.2",
    "react-icons": "^5.3.0"
  }
}
